{
  "name": "go-web-app-forced-delegation",
  "prompt": "prompts/go/benchmark_prompt_forced_delegation.txt",
  "followup_prompt": "prompts/go/benchmark_followup_prompt.txt",
  "results_dir": "results-go",
  "report": "docs/report.go.forced.md",
  "project_profile": {
    "label": "Go",
    "checks": {
      "go_mod": "go.mod",
      "readme_md": "README.md",
      "readme_lower": "readme.md",
      "dockerfile": "Dockerfile",
      "docker_compose_yml": "docker-compose.yml",
      "docker_compose_yaml": "docker-compose.yaml",
      "compose_yml": "compose.yml",
      "compose_yaml": "compose.yaml"
    },
    "core_checks": ["go_mod"],
    "core_globs": ["main.go"],
    "tests_mode": "glob",
    "tests_glob": "*_test.go",
    "readme_checks": ["readme_md", "readme_lower"],
    "compose_checks": ["docker_compose_yml", "docker_compose_yaml", "compose_yml", "compose_yaml"],
    "docker_check": "dockerfile",
    "notes": {
      "yes": "Go module, tests, README, and container files detected.",
